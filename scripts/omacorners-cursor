#!/usr/bin/env python3
"""Poll Hyprland cursor position over the compositor request socket.

Prints `POS <x> <y>` on movement, plus `ARM 0|1` and `DRAG 0|1` when Super or
a pointer button changes. Super/button state is read from `/dev/input/event*`
without grabbing devices. No files are written. No network.
"""

from __future__ import annotations

import json
import os
import select
import socket
import struct
import sys
import time
from typing import Any

EV_KEY = 1
KEY_LEFTMETA = 125
KEY_RIGHTMETA = 126
BTN_CODES = {272, 273, 274, 275, 276}
META_CODES = {KEY_LEFTMETA, KEY_RIGHTMETA}
EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

NEAR_EDGE_PX = 64
IDLE_INTERVAL_S = 0.080
NEAR_INTERVAL_S = 0.025
MONITOR_REFRESH_S = 2.0
HEARTBEAT_S = 0.5
SOCKET_TIMEOUT_S = 0.4
MAX_RESPONSE_BYTES = 256 * 1024


def find_socket(env: dict[str, str] | None = None) -> str | None:
    env = env if env is not None else os.environ
    sig = str(env.get("HYPRLAND_INSTANCE_SIGNATURE") or "").strip()
    if not sig or "/" in sig or ".." in sig or len(sig) > 256:
        return None
    runtime = str(env.get("XDG_RUNTIME_DIR") or "").strip()
    candidates = []
    if runtime and os.path.isabs(runtime):
        candidates.append(os.path.join(runtime, "hypr", sig, ".socket.sock"))
    candidates.append(os.path.join("/tmp/hypr", sig, ".socket.sock"))
    for path in candidates:
        if os.path.exists(path) and stat_is_socket(path):
            return path
    return None


def stat_is_socket(path: str) -> bool:
    try:
        mode = os.stat(path).st_mode
    except OSError:
        return False
    return (mode & 0o170000) == 0o140000


def parse_cursorpos(text: str) -> tuple[int, int] | None:
    raw = (text or "").strip()
    if not raw:
        return None
    # Hyprland answers "x, y" or JSON {"x": N, "y": N}.
    if raw[0] == "{":
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError:
            return None
        if not isinstance(obj, dict):
            return None
        try:
            x = int(obj["x"])
            y = int(obj["y"])
        except (KeyError, TypeError, ValueError):
            return None
        return x, y
    parts = raw.replace(" ", "").split(",")
    if len(parts) != 2:
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None


def parse_monitors(text: str) -> list[dict[str, Any]]:
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return []
    if not isinstance(data, list):
        return []
    out: list[dict[str, Any]] = []
    for item in data[:16]:
        if not isinstance(item, dict):
            continue
        try:
            scale = float(item.get("scale") or 1.0)
        except (TypeError, ValueError):
            scale = 1.0
        if scale <= 0:
            scale = 1.0
        try:
            width = float(item.get("width") or 0)
            height = float(item.get("height") or 0)
            x = int(item.get("x") or 0)
            y = int(item.get("y") or 0)
        except (TypeError, ValueError):
            continue
        logical_w = int(round(width / scale))
        logical_h = int(round(height / scale))
        if logical_w <= 0 or logical_h <= 0:
            continue
        name = item.get("name")
        out.append({
            "name": str(name) if isinstance(name, str) else "",
            "x": x,
            "y": y,
            "width": logical_w,
            "height": logical_h,
        })
    return out


def near_edge(x: int, y: int, monitors: list[dict[str, Any]], px: int = NEAR_EDGE_PX) -> bool:
    margin = max(1, int(px))
    for mon in monitors:
        sx, sy = mon["x"], mon["y"]
        sw, sh = mon["width"], mon["height"]
        if x < sx or y < sy or x >= sx + sw or y >= sy + sh:
            continue
        if (x - sx <= margin or (sx + sw) - x <= margin
                or y - sy <= margin or (sy + sh) - y <= margin):
            return True
    return False


def hypr_request(path: str, command: str, timeout: float = SOCKET_TIMEOUT_S) -> bytes:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(timeout)
        sock.connect(path)
        sock.sendall(command.encode("utf-8"))
        chunks: list[bytes] = []
        total = 0
        while total <= MAX_RESPONSE_BYTES:
            try:
                chunk = sock.recv(min(4096, MAX_RESPONSE_BYTES + 1 - total))
            except socket.timeout:
                break
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > MAX_RESPONSE_BYTES:
            return b""
        return b"".join(chunks)
    finally:
        sock.close()


def emit_pos(x: int, y: int) -> None:
    sys.stdout.write(f"POS {x} {y}\n")
    sys.stdout.flush()


def emit_hit(corner: str, name: str) -> None:
    sys.stdout.write(f"HIT {corner} {name}\n")
    sys.stdout.flush()


def hit_corner(x: int, y: int, monitors: list[dict[str, Any]], threshold: int = 16) -> tuple[str, str]:
    """Layout-pixel corner hit, using the same logical monitor boxes as cursorpos."""
    t = max(2, min(48, int(threshold)))
    for mon in monitors:
        sx, sy = mon["x"], mon["y"]
        sw, sh = mon["width"], mon["height"]
        if sw <= 0 or sh <= 0:
            continue
        if x < sx or y < sy or x >= sx + sw or y >= sy + sh:
            continue
        left = x - sx <= t
        right = (sx + sw) - x <= t
        top = y - sy <= t
        bottom = (sy + sh) - y <= t
        name = str(mon.get("name") or "-") or "-"
        if top and left:
            return "tl", name
        if top and right:
            return "tr", name
        if bottom and left:
            return "bl", name
        if bottom and right:
            return "br", name
    return "none", "-"


def emit_flag(name: str, on: bool) -> None:
    sys.stdout.write(f"{name} {1 if on else 0}\n")
    sys.stdout.flush()


def parse_evdev_events(payload: bytes) -> list[tuple[int, int, int]]:
    out: list[tuple[int, int, int]] = []
    i = 0
    n = len(payload)
    while i + EVENT_SIZE <= n:
        _sec, _usec, ev_type, code, value = struct.unpack_from(EVENT_FORMAT, payload, i)
        i += EVENT_SIZE
        out.append((int(ev_type), int(code), int(value)))
    return out


def open_input_fds(directory: str = "/dev/input") -> list[int]:
    fds: list[int] = []
    try:
        names = os.listdir(directory)
    except OSError:
        return fds
    for name in names:
        if not name.startswith("event"):
            continue
        path = os.path.join(directory, name)
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        if len(fds) >= 32:
            os.close(fd)
            break
        fds.append(fd)
    return fds


def apply_evdev(ev_type: int, code: int, value: int, meta: set[int], buttons: set[int]) -> None:
    if ev_type != EV_KEY:
        return
    down = value != 0
    if code in META_CODES:
        if down:
            meta.add(code)
        else:
            meta.discard(code)
    elif code in BTN_CODES:
        if down:
            buttons.add(code)
        else:
            buttons.discard(code)


def drain_input(fds: list[int], meta: set[int], buttons: set[int]) -> None:
    if not fds:
        return
    try:
        ready, _, _ = select.select(fds, [], [], 0)
    except (OSError, ValueError):
        return
    for fd in ready:
        try:
            payload = os.read(fd, EVENT_SIZE * 64)
        except BlockingIOError:
            continue
        except OSError:
            continue
        if not payload:
            continue
        for ev_type, code, value in parse_evdev_events(payload):
            apply_evdev(ev_type, code, value, meta, buttons)


def main() -> int:
    path = find_socket()
    if not path:
        sys.stderr.write("omacorners-cursor: Hyprland request socket not found\n")
        return 1

    last_pos: tuple[int, int] | None = None
    last_emit = 0.0
    last_monitors_at = 0.0
    monitors: list[dict[str, Any]] = []
    input_fds = open_input_fds()
    meta_held: set[int] = set()
    buttons_held: set[int] = set()
    last_arm: bool | None = None
    last_drag: bool | None = None
    if input_fds:
        emit_flag("ARM", False)
        emit_flag("DRAG", False)
        last_arm = False
        last_drag = False

    try:
        while True:
            drain_input(input_fds, meta_held, buttons_held)
            armed = len(meta_held) > 0
            dragging = len(buttons_held) > 0
            if last_arm is not None and armed != last_arm:
                emit_flag("ARM", armed)
                last_arm = armed
            if last_drag is not None and dragging != last_drag:
                emit_flag("DRAG", dragging)
                last_drag = dragging

            now = time.monotonic()
            if now - last_monitors_at >= MONITOR_REFRESH_S or not monitors:
                raw_mon = hypr_request(path, "j/monitors")
                parsed = parse_monitors(raw_mon.decode("utf-8", "replace"))
                if parsed:
                    monitors = parsed
                last_monitors_at = now

            raw_pos = hypr_request(path, "cursorpos")
            pos = parse_cursorpos(raw_pos.decode("utf-8", "replace"))
            if pos is not None:
                if pos != last_pos or now - last_emit >= HEARTBEAT_S:
                    corner, mon_name = hit_corner(pos[0], pos[1], monitors)
                    emit_hit(corner, mon_name)
                    emit_pos(pos[0], pos[1])
                    last_pos = pos
                    last_emit = now
                interval = NEAR_INTERVAL_S if near_edge(pos[0], pos[1], monitors) else IDLE_INTERVAL_S
            else:
                interval = IDLE_INTERVAL_S
            time.sleep(interval)
    finally:
        for fd in input_fds:
            try:
                os.close(fd)
            except OSError:
                pass


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
    except BrokenPipeError:
        raise SystemExit(0)
